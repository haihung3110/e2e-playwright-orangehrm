{
  "name": "e2e-playwright-sample",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Playwright TypeScript E2E framework, starting with OrangeHRM.",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all": "playwright test",
    "test:sequential": "PW_WORKERS=1 PW_FULLY_PARALLEL=false playwright test" ,
    "test:parallel": "PW_WORKERS=4 PW_FULLY_PARALLEL=true playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:single": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
