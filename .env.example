# Copy this file to .env and replace values only if your target differs.
BASE_URL=https://opensource-demo.orangehrmlive.com
E2E_USERNAME=replace-with-username
E2E_PASSWORD=replace-with-password
# Set true to retain traces for every test run; failures always retain artifacts.
PW_RETAIN_TRACE=false
# Browser/runtime controls. Local runs show Chromium by default; CI stays headless.
PW_HEADLESS=false
PW_WORKERS=1
PW_FULLY_PARALLEL=false
PW_RETRIES=0
